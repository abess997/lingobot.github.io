# Copy to .env.local and fill in. Never commit real values.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://user:password@localhost:5432/dealline
APP_URL=https://app.example.sa
SITES_ROOT_DOMAIN=example.site

# Email (Resend). Empty in development: emails print to the console.
RESEND_API_KEY=
EMAIL_FROM="Deal Line <no-reply@example.sa>"

# Moyasar: test keys (pk_test_ / sk_test_) until deploy
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Encrypts per-org secrets (WhatsApp tokens, webhook signing secrets). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# WhatsApp Business Platform (Cloud API): Deal Line's Meta app
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0
